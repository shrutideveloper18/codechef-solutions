import java.util.*;
import java.lang.*;
import java.io.*;

class Codechef
{
	public static void main (String[] args) throws java.lang.Exception
	{
		// your code goes here
		Scanner s=new Scanner(System.in);
		int t=s.nextInt();
		for(int i=0;i<t;i++){
		    int x=s.nextInt();
		    int a=s.nextInt();
		    int b=s.nextInt();
		    int score=a*1+b*2;
		    if(score>=x){
		        System.out.println("qualify");
		    }
		    else{
		        System.out.println("notqualify");
		    }
		}
		

	}
}
