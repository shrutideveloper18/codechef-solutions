import java.util.*;
import java.lang.*;
import java.io.*;

class Codechef
{
	public static void main (String[] args) throws java.lang.Exception
	{
		// your code goes here
		Scanner s=new Scanner(System.in);
		int t=s.nextInt();
		for(int i=0;i<t;i++){
		    int x=s.nextInt();
		    if(x%10==0){
		        System.out.println(x/10);
		    }
		    else if(x%5!=0){
		        System.out.println(-1);
		    }
		    else{
		        int coins=(x/10)+((x-(x/10)*10)/5);
		         System.out.println(coins);
		    }
		   
		}

	}
}
