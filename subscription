import java.util.*;
import java.lang.*;
import java.io.*;

class Codechef
{
	public static void main (String[] args) throws java.lang.Exception
	{
		// your code goes here
		Scanner s=new Scanner(System.in);
		int t=s.nextInt();
		for(int i=0;i<t;i++){
		    int n=s.nextInt();
		    int x=s.nextInt();
		    if(n<=6){
		        System.out.println(x);
		    }
		    else if(n%6==0){
		        System.out.println((n/6)*x);
		    }
		    else{
		        System.out.println(((n/6)+1)*x);
		    }
		}

	}
}
