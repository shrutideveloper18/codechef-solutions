import java.util.*;
import java.lang.*;
import java.io.*;

class Codechef
{
	public static void main (String[] args) throws java.lang.Exception
	{
		// your code goes here
		Scanner s=new Scanner(System.in);
		int t=s.nextInt();
		for(int i=0;i<t;i++){
		    int x=s.nextInt();
		    int y=s.nextInt();
		    int z=s.nextInt();
		    if(x<=z&&x+y>z){
		        System.out.println(1);
		    }
		    else if(x>z){
		        System.out.println(0);
		    }
		    else{
		        System.out.println(2);
		    }
		}

	}
}
