import java.util.*;
import java.lang.*;
import java.io.*;

class Codechef
{
	public static void main (String[] args) throws java.lang.Exception
	{
		// your code goes here
		Scanner s=new Scanner(System.in);
		int x=s.nextInt();
		double y=s.nextDouble();
		if((x%5==0)&&(x+0.5<=y)){
		    System.out.printf("%.2f\n",y-x-0.50);
		}
		else{
		    System.out.printf("%.2f\n",y);
		}
	}
}
