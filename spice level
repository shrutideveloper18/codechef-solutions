import java.util.*;
import java.lang.*;
import java.io.*;

class Codechef
{
	public static void main (String[] args) throws java.lang.Exception
	{
		// your code goes here
		Scanner s=new Scanner(System.in);
		int t=s.nextInt();
		for(int i=0;i<t;i++){
		    int x=s.nextInt();
		    if(x<4){
		        System.out.println("mild");
		    }
		    else if(x>=4&&x<7){
		        System.out.println("medium");
		    }
		    else{
		        System.out.println("hot");
		    }
		}
	}
}
