import java.util.*;
import java.lang.*;
import java.io.*;

class Codechef
{
	public static void main (String[] args) throws java.lang.Exception
	{
		// your code goes here
		Scanner s=new Scanner(System.in);
		int t=s.nextInt();
		for(int i=0;i<t;i++){
		    int w=s.nextInt();
		    int x=s.nextInt();
		    int y=s.nextInt();
		    int z=s.nextInt();
		    for(int j=0;j<z;j++){
		        w=w+x-y;
		    }
		    System.out.println(w);
		}

	}
}
