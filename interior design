import java.util.*;
import java.lang.*;
import java.io.*;

class Codechef
{
	public static void main (String[] args) throws java.lang.Exception
	{
		// your code goes here
		Scanner s=new Scanner(System.in);
		int t=s.nextInt();
		for(int i=0;i<t;i++){
		    int x1=s.nextInt();
		    int y1=s.nextInt();
		    int x2=s.nextInt();
		    int y2=s.nextInt();
		    int s1=x1+y1;
		    int s2=x2+y2;
		    if(s1>s2){
		        System.out.println(s2);
		    }
		    else{
		        System.out.println(s1);
		    }
		}

	}
}
