import java.util.*;
import java.lang.*;
import java.io.*;

class Codechef
{
	public static void main (String[] args) throws java.lang.Exception
	{
		// your code goes here
		Scanner s=new Scanner(System.in);
		int T=s.nextInt();
		for(int i=0;i<T;i++){
		    int week=s.nextInt();
		    int coins=s.nextInt();
		    int fee=week*coins;
		    System.out.println(fee);
		}

	}
}
