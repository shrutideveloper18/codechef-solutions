import java.util.*;
import java.lang.*;
import java.io.*;

class Codechef
{
	public static void main (String[] args) throws java.lang.Exception
	{
		// your code goes here
		Scanner s=new Scanner(System.in);
		int t=s.nextInt();
		for(int i=0;i<t;i++){
		    int x=s.nextInt();
		    int y=s.nextInt();
		    int x1=3*x;
		    int y1=2*y;
		    if(x1<y1){
		        System.out.println(x1);
		    }
		    else{
		        System.out.println(y1);
		    }
		}

	}
}
